__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
*.egg-info/
build/
dist/
logs/
data/
*.db

# Artes de clientes e arquivos gerados (nao versionar)
*.pdf
*.dxf
# EXCECAO: o arquivo do tutorial guiado e RECURSO do produto, nao arte de
# cliente. Sem ele versionado, um clone limpo (ou o build) sai sem o exemplo e
# o tutorial guiado quebra na mao de quem instalou.
!assets/exemplo/*.pdf

# Build / distribuicao (gerados pelo PyInstaller / build.bat)
PrintNest_Build/
*.exe
assets/printnest.ico

# SEGREDO: chave privada de licenciamento — NUNCA versionar (quem tiver ela
# forja licencas). Fica so na maquina do dono do produto.
tools/license_private_key.pem
*.private.pem
licenses_emitidas/
# credenciais da conta de e-mail do robo de ativacao
tools/robot_config.json

# Site (app Node/Vite): dependencias nunca vao para o Git
node_modules/

# zips de build para envio (gerados localmente)
PrintNest_Build_*.zip
